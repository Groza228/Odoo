<odoo>
    <record id="view_library_return_wizard_form" model="ir.ui.view">
        <field name="name">library.return.wizard.form</field>
        <field name="model">library.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Оформлення повернення">
                <group>
                    <field name="loan_id" readonly="1"/>
                    <field name="condition_on_return"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Підтвердити повернення"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Скасувати"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_return_wizard" model="ir.actions.act_window">
        <field name="name">Оформлення повернення</field>
        <field name="res_model">library.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
